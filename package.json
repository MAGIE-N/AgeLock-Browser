{
  "name": "agelocknew",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "rebuild": "node scripts/rebuild-native.js",
    "postinstall": "npm run rebuild",
    "dev": "webpack serve --config webpack.config.js --mode development --port 3000",
    "build": "webpack --config webpack.config.js && webpack --config webpack.main.config.js",
    "start": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "cross-env NODE_ENV=production webpack --config webpack.config.js && webpack --config webpack.main.config.js",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron-dev": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "install": "node-gyp rebuild"
  },
  "keywords": [
    "age-adaptive filtering",
    "client-side AI",
    "TPM security"
  ],
  "author": "",
  "license": "ISC",
  "description": "Age-restricted secure browser",
  "dependencies": {
    "node-addon-api": "^5.0.0",
    "nan": "^2.19.0",
    "electron-rebuild": "^3.2.9",
    "electron-builder": "^26.0.12",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "@tensorflow/tfjs": "^4.0.0",
    "@tensorflow/tfjs-node": "^4.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.0.0",
    "@tensorflow-models/distilbert": "^1.0.0",
    "nsfwjs": "^2.0.0",
    "secure-web-storage": "^1.0.0",
    "@shap/shap": "^0.40.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.3",
    "shap": "^0.1.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "date-fns": "^4.1.0",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "gypfile": true
}
